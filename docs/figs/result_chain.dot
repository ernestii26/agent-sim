  m -> y [label=<  <b>H6</b> path b&#160;&#160;&#8722;0.006<br/>  [&#8722;0.09, 0.08]  > color="#b5473a" fontcolor="#b5473a" style=dotted];
  x -> y [label=<  <b>interaction</b>&#160;&#160;p = .008  > color="#3d6a99" fontcolor="#3d6a99" constraint=false];
