        color="#8a9099" penwidth=1.2 margin="0.22,0.15"];
  edge [penwidth=2.0 arrowsize=0.9 fontname="Helvetica" fontsize=13];

  x [label=<<b>THREAT</b><br/><font point-size="11" color="#5b6470">vs collaborative</font>> fillcolor="#e8e3d9" color="#a89f8d"];
  m [label=<<b>PROTECTION need</b><br/><font point-size="11" color="#5b6470">within person, before &#8594; after</font>> fillcolor="#f6e7d6"];
  p [label=<<b>LEADER PROTOTYPE</b><br/><font point-size="11" color="#5b6470">what a leader should be</font>> fillcolor="#eef0f2"];
  y [label=<<b>DOMINANCE endorsed</b><br/><font point-size="11" color="#5b6470">the respondent's own vote</font>> fillcolor="#f6dfd6" color="#c98d76"];

  {rank=same; m; p;}

