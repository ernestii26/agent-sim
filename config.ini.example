; Copy to config.ini and fill in your key. config.ini is gitignored.
[OpenAI]
API_KEY = sk-...

; Default backoff is 2s * 5^attempt (2/10/50/250/1250s), 5 attempts — over 5 minutes
; wasted on a single call before giving up. A LengthFinishReasonError (see P7 in
; docs/ERRORS_AND_FIXES.md) is deterministic: the same prompt truncates at the same
; ceiling every retry, so waiting longer never helps it succeed. Real 429s still get
; several tries, just faster ones. The actual fix for truncation is DISCUSSION_MAX_TOKENS
; below.
MAX_ATTEMPTS = 3
EXPONENTIAL_BACKOFF_FACTOR = 3

[Simulation]
DISCUSSION_MODEL = gpt-4.1
VOTE_MODEL = gpt-4.1
DISCUSSION_TEMPERATURE = 0.7
VOTE_TEMPERATURE = 0.2
; Truncation risk grows with transcript length, not persona size alone — a long,
; many-participant discussion can push prompt_tokens well past what a single persona's
; system prompt would suggest. See P3 and P7 in docs/ERRORS_AND_FIXES.md.
DISCUSSION_MAX_TOKENS = 6000
VOTE_MAX_TOKENS = 3000

; Survey instruments (FFNI, ILT, effectiveness ratings).
; A 22-item battery is answered in one call, so keep the token ceiling high; the
; 45-item ILT reconstruction needs 4500.
SURVEY_MODEL = gpt-4.1
; Zero, not merely low. At 0.2 the 45-item prototype battery failed measure-check's
; test-retest gate outright (mean r .35 against a floor of .40) and passed at 0 with
; .47 — see docs/design-log.md section 25. A rating scale is a measurement, and the
; decoding randomness was the largest single thing it was measuring. Note this rules
; out the gpt-5 family here: TinyTroupe strips a non-default temperature for those.
SURVEY_TEMPERATURE = 0
SURVEY_MAX_TOKENS = 4500

; Main run
RUNS = 20
ROUNDS = 3

; `run.py validate`
VALIDATE_RUNS = 5
VALIDATE_ROUNDS = 5

OUTPUT_DIR = results
