# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Secrets — never commit
config.ini

# Per-run artifacts: logs and raw transcripts are large and regenerable.
# Final summaries and charts (results/<study>/<condition>/*.json|png) stay tracked.
results/**/checkpoints/
results/**/logs/
# Throwaway output from cheap-model smoke runs: results_smoke, results_smoke2, ...
results_*/

# Agent worktrees
.claude/worktrees/

# Sheng thesis PDF: 167 MB, over GitHub's 100 MB limit. Items transcribed in docs/sheng-2026-S10.1-effectiveness-items.md
docs/xsheng-thesis-withcover*.pdf
# Replication personas are rebuilt from bank_sample.json and the seed by tools/replicate_study5.py
results/replication/*/personas/
# Traits-only personas are rebuilt from ffni_mediation by tools/make_dp_check_traits.py
studies/dp_check_traits/personas/
# nohup stdout of background runs
results/**/*.out
